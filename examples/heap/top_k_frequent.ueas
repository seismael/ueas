module examples.heap

Algorithm MaxElement(nums: List<Int>) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut m <- nums[0]
    for i in 1..nums.length do m <- max(m, nums[i]) end for
    return m
end Algorithm

@Test "MaxElement"
    assert MaxElement([1, 5, 3]) == 5
end Test
