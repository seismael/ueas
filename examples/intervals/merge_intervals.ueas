module examples.intervals

Algorithm OverlapCount(starts: List<Int>, ends: List<Int>) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut c <- 0
    for i in 1..starts.length do
        if starts[i] <= ends[i - 1] then c <- c + 1 end if
    end for
    return c
end Algorithm

@Test "OverlapCount"
    assert OverlapCount([1, 2], [4, 5]) == 1
end Test
