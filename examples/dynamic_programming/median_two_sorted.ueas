module examples.dynamic_programming

Algorithm MedianTwoSorted(a: List<Int>, b: List<Int>) -> Real
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut m <- []
    let mut i <- 0
    let mut j <- 0
    while i < a.length and j < b.length do
        if a[i] <= b[j] then m.push(a[i])
            i <- i + 1
        else m.push(b[j])
            j <- j + 1
        end if
    end while
    while i < a.length do m.push(a[i])
        i <- i + 1
    end while
    while j < b.length do m.push(b[j])
        j <- j + 1
    end while
    let n <- m.length
    if n % 2 == 1 then return m[n / 2] * 1.0 end if
    return (m[n / 2 - 1] + m[n / 2]) / 2.0
end Algorithm

@Test "MedianTwoSorted"
    assert MedianTwoSorted([1, 3], [2]) == 2.0
end Test
