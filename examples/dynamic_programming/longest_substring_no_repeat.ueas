module examples.dynamic_programming

Algorithm LengthOfLongestSubstring(s: String) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut best <- 0
    let mut start <- 0
    let mut last <- Map()
    for i in 0..s.length do
        let ch <- s[i]
        if last.contains(ch) and last[ch] >= start then
            start <- last[ch] + 1
        end if
        last.insert(ch, i)
        best <- max(best, i - start + 1)
    end for
    return best
end Algorithm

@Test "LengthOfLongestSubstring"
    assert LengthOfLongestSubstring("abcabcbb") == 3
end Test
