module examples.dynamic_programming

Algorithm MaxSubarray(nums: List<Int>) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut best <- nums[0]
    let mut cur <- nums[0]
    for i in 1..nums.length do
        cur <- max(nums[i], cur + nums[i])
        best <- max(best, cur)
    end for
    return best
end Algorithm

@Test "MaxSubarray"
    assert MaxSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4]) == 6
end Test
