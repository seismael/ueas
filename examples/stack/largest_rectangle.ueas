module examples.stack

Algorithm LargestRectArea(heights: List<Int>) -> Int
    Complexity:
        Time: O(N^2),
        Space: O(1)

    let mut best <- 0
    for i in 0..heights.length do
        let mut h <- heights[i]
        for j in i..heights.length do
            h <- min(h, heights[j])
            best <- max(best, h * (j - i + 1))
        end for
    end for
    return best
end Algorithm

@Test "LargestRectArea"
    assert LargestRectArea([2, 1, 5, 6, 2, 3]) == 10
end Test
