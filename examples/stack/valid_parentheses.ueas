module examples.stack

Algorithm ValidParens(s: String) -> Bool
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut bal <- 0
    for i in 0..s.length do
        if s[i] == "(" then bal <- bal + 1
        else bal <- bal - 1 end if
        if bal < 0 then return false end if
    end for
    return bal == 0
end Algorithm

@Test "ValidParens"
    assert ValidParens("(())") == true
end Test
