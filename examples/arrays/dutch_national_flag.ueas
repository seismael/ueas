module examples.arrays

Algorithm DutchNationalFlag(mut arr: List<Int>) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut low <- 0
    let mut mid <- 0
    let mut high <- arr.length - 1
    while mid <= high do
        if arr[mid] == 0 then
            arr.swap(low, mid)
            low <- low + 1
            mid <- mid + 1
        else if arr[mid] == 1 then
            mid <- mid + 1
        else
            arr.swap(mid, high)
            high <- high - 1
        end if
    end while
    return arr
end Algorithm

@Test "dutch national flag"
    assert DutchNationalFlag([2, 0, 2, 1, 1, 0]) == [0, 0, 1, 1, 2, 2]
end Test
