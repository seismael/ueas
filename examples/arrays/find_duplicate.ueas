module examples.arrays

Algorithm FindDuplicate(nums: List<Int>) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut slow <- nums[0]
    let mut fast <- nums[0]
    slow <- nums[slow]
    fast <- nums[nums[fast]]
    while slow != fast do
        slow <- nums[slow]
        fast <- nums[nums[fast]]
    end while
    let mut ptr1 <- nums[0]
    let mut ptr2 <- slow
    while ptr1 != ptr2 do
        ptr1 <- nums[ptr1]
        ptr2 <- nums[ptr2]
    end while
    return ptr1
end Algorithm

@Test "find duplicate"
    assert FindDuplicate([1, 3, 4, 2, 2]) == 2
end Test
