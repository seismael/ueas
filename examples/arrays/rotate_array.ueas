module examples.arrays

Algorithm RotateArray(mut nums: List<Int>, k: Int) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(1)

    let n <- nums.length
    if n == 0 then
        return nums
    end if
    let s <- k % n
    nums.reverse()
    let mut l <- 0
    let mut r <- s - 1
    while l < r do
        nums.swap(l, r)
        l <- l + 1
        r <- r - 1
    end while
    l <- s
    r <- n - 1
    while l < r do
        nums.swap(l, r)
        l <- l + 1
        r <- r - 1
    end while
    return nums
end Algorithm

@Test "rotate array"
    assert RotateArray([1, 2, 3, 4, 5], 2) == [4, 5, 1, 2, 3]
end Test
