module examples.arrays

Algorithm NextPermutation(mut nums: List<Int>) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(1)

    let n <- nums.length
    let mut i <- n - 2
    while i >= 0 and nums[i] >= nums[i + 1] do
        i <- i - 1
    end while
    if i >= 0 then
        let mut j <- n - 1
        while nums[j] <= nums[i] do
            j <- j - 1
        end while
        nums.swap(i, j)
    end if
    let mut l <- i + 1
    let mut r <- n - 1
    while l < r do
        nums.swap(l, r)
        l <- l + 1
        r <- r - 1
    end while
    return nums
end Algorithm

@Test "next permutation"
    assert NextPermutation([1, 2, 3]) == [1, 3, 2]
end Test
