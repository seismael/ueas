module examples.arrays

Algorithm TwoSum(nums: List<Int>, target: Int) -> Option<Tuple<Int, Int>>
    Complexity:
        Time: O(N),
        Space: O(N)

    let mut seen: Map<Int, Int> <- Map()
    for i in 0..nums.length do
        let need <- target - nums[i]
        if seen.contains(need) then
            return Some((seen[need], i))
        end if
        seen.insert(nums[i], i)
    end for
    return None
end Algorithm

@Test "two sum"
    assert TwoSum([2, 7, 11, 15], 9) == Some((0, 1))
end Test
