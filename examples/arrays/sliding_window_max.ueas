module examples.arrays

Algorithm SlidingWindowMax(nums: List<Int>, k: Int) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(N)

    let mut out <- []
    if nums.length == 0 or k <= 0 then
        return out
    end if
    for i in 0..=(nums.length - k) do
        let mut m <- nums[i]
        for j in (i + 1)..(i + k) do
            m <- max(m, nums[j])
        end for
        out.push(m)
    end for
    return out
end Algorithm

@Test "sliding window max"
    assert SlidingWindowMax([1, 3, -1, -3, 5, 3, 6, 7], 3) == [3, 3, 5, 5, 6, 7]
end Test
