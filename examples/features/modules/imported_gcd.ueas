module examples.features.modules

Algorithm GcdPair(a: Int, b: Int) -> Int
    Complexity:
        Time: O(log N) where N = a,
        Space: O(1)

    let mut x <- a
    let mut y <- b
    while y != 0 do let t <- y
        y <- x % y
        x <- t
    end while
    return x
end Algorithm

@Test "GcdPair"
    assert GcdPair(21, 14) == 7
end Test
