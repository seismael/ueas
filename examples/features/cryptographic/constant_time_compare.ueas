module examples.crypto

@ConstantTime
Algorithm ConstantTimeSelectMax(a: Secret<Int>, b: Secret<Int>) -> Secret<Int>
    Complexity:
        Time: O(1),
        Space: O(1)

    return select(a >= b, a, b)
end Algorithm

@Test "constant time select"
    assert ConstantTimeSelectMax(10, 25) == 25
end Test
