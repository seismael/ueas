module examples.features.hardware

Algorithm CacheLinearScan(data: List<Int>, target: Int) -> Option<Int>
    Complexity:
        Time: O(N),
        Space: O(1)

    for i in 0..data.length do
        if data[i] == target then return Some(i) end if
    end for
    return None
end Algorithm

@Test "CacheLinearScan"
    assert CacheLinearScan([10, 20, 30], 20) == Some(1)
end Test
