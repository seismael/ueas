module examples.features.advanced

Algorithm InPlaceSelect(mut arr: List<Int>) -> List<Int>
    Complexity:
        Time: O(N^2),
        Space: O(1)

    for i in 0..arr.length do
        for j in (i + 1)..arr.length do
            if arr[j] < arr[i] then arr.swap(i, j) end if
        end for
    end for
    return arr
end Algorithm

@Test "InPlaceSelect"
    assert InPlaceSelect([3, 1, 2]) == [1, 2, 3]
end Test
