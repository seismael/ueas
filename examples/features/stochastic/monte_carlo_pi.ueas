module examples.stochastic

Algorithm EstimatePi(samples: Int) -> Real
    Require:
        samples > 0
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut inside <- 0
    for i in 0..samples do
        let x <- rand_real()
        let y <- rand_real()
        if x * x + y * y <= 1.0 then
            inside <- inside + 1
        end if
    end for
    return (4.0 * (inside as Real)) / (samples as Real)
end Algorithm

@Test "monte carlo pi"
    let pi <- EstimatePi(100)
    assert pi > 2.0 and pi < 4.0
end Test
