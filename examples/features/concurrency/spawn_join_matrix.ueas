module examples.features.concurrency

Algorithm ParallelRowSum(mat: List<List<Int>>) -> Int
    Complexity:
        Time: O(N^2),
        Space: O(1)

    let mut total <- 0
    parallel for i in 0..mat.length do
        let row <- mat[i]
        for j in 0..row.length do
            total <- total + row[j]
        end for
    end for
    return total
end Algorithm

@Test "ParallelRowSum"
    assert ParallelRowSum([[1, 2], [3, 4]]) == 10
end Test
