module examples.concurrency

Algorithm ParallelSum(n: Int) -> Int
    Complexity:
        Time: O(N),
        Work: O(N),
        Span: O(log N)

    let mut total <- 0
    parallel for i in 0..n do
        total <- total + i
    end for
    return total
end Algorithm

@Test "parallel sum"
    assert ParallelSum(5) == 10
end Test
