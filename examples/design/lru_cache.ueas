module examples.design

Algorithm LruTouch(mut order: List<Int>, key: Int) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut out <- []
    for i in 0..order.length do
        if order[i] != key then out.push(order[i]) end if
    end for
    out.push(key)
    return out
end Algorithm

@Test "LruTouch"
    assert LruTouch([1, 2, 3], 2) == [1, 3, 2]
end Test
