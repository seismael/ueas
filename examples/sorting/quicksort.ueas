module examples.sorting

Algorithm ExQuickSort(mut a: List<Int>) -> List<Int>
    Complexity:
        Time: O(N^2),
        Space: O(1)

    for i in 0..a.length do
        for j in (i + 1)..a.length do
            if a[j] < a[i] then a.swap(i, j) end if
        end for
    end for
    return a
end Algorithm

@Test "ExQuickSort"
    assert ExQuickSort([4, 1, 3, 2]) == [1, 2, 3, 4]
end Test
