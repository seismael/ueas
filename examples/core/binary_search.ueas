module examples.core

Algorithm BinarySearch(data: List<Int>, target: Int) -> Option<Int>
    Require:
        forall i in 0..(data.length - 1) :: data[i] <= data[i + 1]
    Complexity:
        Time: O(log N) where N = data.length,
        Space: O(1)

    let mut low <- 0
    let mut high <- data.length - 1
    while low <= high do
        invariant 0 <= low
        decreases high - low + 1
        let mid <- low + (high - low) / 2
        if data[mid] == target then
            return Some(mid)
        else if data[mid] < target then
            low <- mid + 1
        else
            high <- mid - 1
        end if
    end while
    return None
end Algorithm

@Test "binary search"
    assert BinarySearch([1, 3, 5, 7, 9], 7) == Some(3)
    assert BinarySearch([1, 3, 5, 7, 9], 4) == None
end Test
