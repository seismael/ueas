module examples.backtracking

Algorithm HammingDistance(a: String, b: String) -> Int
    Complexity:
        Time: O(N),
        Space: O(1)

    let mut d <- 0
    for i in 0..min(a.length, b.length) do
        if a[i] != b[i] then d <- d + 1 end if
    end for
    return d
end Algorithm

@Test "HammingDistance"
    assert HammingDistance("hit", "hot") == 1
end Test
