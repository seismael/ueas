module std.math

Algorithm SieveOfEratosthenes(limit: Int) -> List<Int>
    Require:
        limit >= 0
    Complexity:
        Time: O(N log N),
        Space: O(N)

    if limit < 2 then
        return []
    end if
    let mut is_prime <- []
    for i in 0..=limit do
        is_prime.push(true)
    end for
    is_prime[0] <- false
    is_prime[1] <- false
    let mut p <- 2
    while p * p <= limit do
        if is_prime[p] then
            let mut m <- p * p
            while m <= limit do
                is_prime[m] <- false
                m <- m + p
            end while
        end if
        p <- p + 1
    end while
    let mut primes <- []
    for i in 2..=limit do
        if is_prime[i] then
            primes.push(i)
        end if
    end for
    return primes
end Algorithm

@Test "sieve"
    assert SieveOfEratosthenes(20) == [2, 3, 5, 7, 11, 13, 17, 19]
end Test
