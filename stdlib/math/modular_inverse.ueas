module std.math

Algorithm ModInverse(a: Int, m: Int) -> Option<Int>
    Require:
        m > 1
    Complexity:
        Time: O(log N) where N = m,
        Space: O(1)

    let mut t <- 0
    let mut new_t <- 1
    let mut r <- m
    let mut new_r <- ((a % m) + m) % m
    while new_r != 0 do
        let q <- r / new_r
        let tmp_t <- t - q * new_t
        t <- new_t
        new_t <- tmp_t
        let tmp_r <- r - q * new_r
        r <- new_r
        new_r <- tmp_r
    end while
    if r > 1 then
        return None
    end if
    if t < 0 then
        t <- t + m
    end if
    return Some(t)
end Algorithm

@Test "modular inverse"
    assert ModInverse(3, 11) == Some(4)
end Test
