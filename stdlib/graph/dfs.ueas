module std.graph

Algorithm DfsOrder(adj: List<List<Int>>, start: Int) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(N)

    let n <- adj.length
    let mut visited <- []
    for i in 0..n do
        visited.push(false)
    end for
    let mut stack <- [start]
    let mut order <- []
    while stack.length > 0 do
        let u <- stack.pop().unwrap()
        if visited[u] then
            continue
        end if
        visited[u] <- true
        order.push(u)
        let nbrs <- adj[u]
        let mut i <- nbrs.length - 1
        while i >= 0 do
            let v <- nbrs[i]
            if not visited[v] then
                stack.push(v)
            end if
            i <- i - 1
        end while
    end while
    return order
end Algorithm

@Test "dfs traversal"
    assert DfsOrder([[1, 2], [3], [], []], 0) == [0, 1, 3, 2]
end Test
