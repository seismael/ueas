module std.data_structures

Algorithm SegTreeBuild(arr: List<Int>) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(N)

    let n <- arr.length
    let mut tree <- []
    for i in 0..(2 * n) do
        tree.push(0)
    end for
    for i in 0..n do
        tree[n + i] <- arr[i]
    end for
    let mut i <- n - 1
    while i >= 1 do
        tree[i] <- tree[2 * i] + tree[2 * i + 1]
        i <- i - 1
    end while
    return tree
end Algorithm

Algorithm SegTreeQuery(tree: List<Int>, n: Int, left: Int, right: Int) -> Int
    Complexity:
        Time: O(log N),
        Space: O(1)

    let mut l <- left + n
    let mut r <- right + n
    let mut sum <- 0
    while l < r do
        if l % 2 == 1 then
            sum <- sum + tree[l]
            l <- l + 1
        end if
        if r % 2 == 1 then
            r <- r - 1
            sum <- sum + tree[r]
        end if
        l <- l / 2
        r <- r / 2
    end while
    return sum
end Algorithm

@Test "segment tree range sum"
    let arr <- [1, 3, 5, 7, 9, 11]
    let tree <- SegTreeBuild(arr)
    assert SegTreeQuery(tree, 6, 1, 4) == 15
end Test
