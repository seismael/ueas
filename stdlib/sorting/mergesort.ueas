module std.sorting

Algorithm MergeSort(data: List<Int>) -> List<Int>
    Ensure(res):
        res.length == data.length
    Complexity:
        Time: O(N log N) where N = data.length,
        Space: O(N)

    let n <- data.length
    if n <= 1 then
        return data
    end if
    let mid <- n / 2
    let left <- MergeSort(data[0..mid])
    let right <- MergeSort(data[mid..n])
    return MergeLists(left, right)
end Algorithm

Algorithm MergeLists(left: List<Int>, right: List<Int>) -> List<Int>
    Complexity:
        Time: O(N),
        Space: O(N)

    let mut out <- []
    let mut i <- 0
    let mut j <- 0
    while i < left.length and j < right.length do
        if left[i] <= right[j] then
            out.push(left[i])
            i <- i + 1
        else
            out.push(right[j])
            j <- j + 1
        end if
    end while
    while i < left.length do
        out.push(left[i])
        i <- i + 1
    end while
    while j < right.length do
        out.push(right[j])
        j <- j + 1
    end while
    return out
end Algorithm

@Test "mergesort"
    assert MergeSort([9, 3, 7, 1, 8, 2]) == [1, 2, 3, 7, 8, 9]
end Test
