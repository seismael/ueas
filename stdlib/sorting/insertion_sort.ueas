module std.sorting

Algorithm InsertionSort(mut data: List<Int>) -> List<Int>
    Ensure(res):
        res.length == data.length
    Complexity:
        Time: O(N^2) where N = data.length,
        Space: O(1)

    for i in 1..data.length do
        let key <- data[i]
        let mut j <- i - 1
        while j >= 0 and data[j] > key do
            data[j + 1] <- data[j]
            j <- j - 1
        end while
        data[j + 1] <- key
    end for
    return data
end Algorithm

@Test "insertion sort"
    assert InsertionSort([5, 2, 4, 1, 3]) == [1, 2, 3, 4, 5]
end Test
